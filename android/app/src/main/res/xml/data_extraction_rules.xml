<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what Auto Backup (Google account) and device-to-device
     transfer copy: the ledger, which is small enough for the 25 MB cloud
     quota. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="ledger.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="ledger.json" />
    </device-transfer>
</data-extraction-rules>
