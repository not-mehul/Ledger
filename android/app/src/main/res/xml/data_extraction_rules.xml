<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what Auto Backup (Google account) and device-to-device
     transfer copy. The ledger itself is tiny and always fits in the 25 MB
     cloud quota; photos only travel on device transfer and in the app's
     own .zip backups, so a large photo library can't break cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="ledger.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="ledger.json" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
