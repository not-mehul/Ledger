<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: start rating a city (src/platform/incoming.ts, ledger://new). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="rate"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_rate"
        android:shortcutShortLabel="@string/shortcut_rate_short"
        android:shortcutLongLabel="@string/shortcut_rate_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.notmehul.ledger"
            android:targetClass="io.github.notmehul.ledger.MainActivity"
            android:data="ledger://new" />
    </shortcut>
</shortcuts>
